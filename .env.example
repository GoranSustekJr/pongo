# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 48
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=pongo
API_PORT=8081

# Accounts with these emails are enabled on first sign in, all others start disabled.
# With "Hide My Email" on Apple, use the relay address or enable the user with scripts/enable_user.sh
ALLOWED_EMAILS=

# Google sign in: OAuth client ids from Google Cloud Console
IOS_CLIENT_ID=
WEB_CLIENT_ID=
DESKTOP_CLIENT_ID=

# Sign in with Apple. Put the .p8 key in ./secrets (mounted read-only into the container)
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.example.pongo
APPLE_PRIVATE_KEY_PATH=/run/pongo-secrets/apple_key.p8

MAX_CONCURRENT_DOWNLOADS=4
# YouTube clients yt-dlp tries in order; visionos skips the 5s wait of yt-dlp's default clients
YTDLP_PLAYER_CLIENTS=visionos,default
YTDLP_AUTO_UPDATE=true
# Only if YouTube starts asking for sign-in: export cookies to ./secrets, e.g. /run/pongo-secrets/youtube_cookies.txt
YTDLP_COOKIES_FILE=

# Hostname for HTTPS when the server is reachable from the internet (docker-compose.public.yml)
PONGO_DOMAIN=
