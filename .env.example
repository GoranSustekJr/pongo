# ./setup.sh copies this to .env with fresh secrets; .env is never committed.
# To do it by hand, generate the secrets with: openssl rand -hex 48
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=pongo
API_PORT=8081
# The name the apps show when they connect
SERVER_NAME=Pongo

# Anyone who can reach the server can create an account with a username and password.
# Set it to false to let in only the people below
OPEN_SIGNUP=true
# Username and password accounts; on an invite-only server create them with
#   docker compose exec api python -m library.auth.passwords create <username>
PASSWORD_ACCOUNTS=true

# With OPEN_SIGNUP=false, only these emails, and those added with
# scripts/enable_user.sh, can sign in with Google or Apple.
# With "Hide My Email" on Apple, use the relay address
ALLOWED_EMAILS=

# Optional. Google sign in: OAuth client ids from Google Cloud Console. Leave them
# empty to use only username and password accounts
IOS_CLIENT_ID=
WEB_CLIENT_ID=
DESKTOP_CLIENT_ID=

# Optional. Sign in with Apple. Put the .p8 key in ./secrets (mounted read-only into the container)
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.example.pongo
APPLE_PRIVATE_KEY_PATH=/run/pongo-secrets/apple_key.p8

MAX_CONCURRENT_DOWNLOADS=4
# YouTube clients yt-dlp tries in order; visionos skips the 5s wait of yt-dlp's default clients
YTDLP_PLAYER_CLIENTS=visionos,default
# Installs the newest yt-dlp at every start, untested; off means the pinned version in requirements.txt
YTDLP_AUTO_UPDATE=false
# Only if YouTube starts asking for sign-in: export cookies to ./secrets, e.g. /run/pongo-secrets/youtube_cookies.txt
YTDLP_COOKIES_FILE=

# Hostname for HTTPS when the server is reachable from the internet (docker-compose.public.yml)
PONGO_DOMAIN=
