    "importfilesfooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists of any length: export them to a CSV file at tunemymusic.com (Spotify → Export to file) or exportify.app, right away and without Premium. Spotify's own data download (spotify.com/account/privacy, \"Account data\") takes a few days and brings every playlist and your Liked Songs: unzip it and choose Playlist1.json and YourLibrary.json. Playlists exported from the Music app work too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlists jeder Länge: Exportiere sie auf tunemymusic.com (Spotify → Export to file) oder exportify.app als CSV-Datei, sofort und ohne Premium. Spotifys eigener Datendownload (spotify.com/account/privacy, „Kontodaten“) dauert ein paar Tage und bringt alle Playlists und deine Lieblingssongs: Entpacke ihn und wähle Playlist1.json und YourLibrary.json. Aus der Musik-App exportierte Playlists gehen auch."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Playliste bilo koje duljine: izvezi ih u CSV datoteku na tunemymusic.com (Spotify → Export to file) ili exportify.app, odmah i bez Premiuma. Spotifyjevo preuzimanje podataka (spotify.com/account/privacy, „Podaci o računu”) traje nekoliko dana i donosi sve playliste i pjesme koje ti se sviđaju: raspakiraj ga i odaberi Playlist1.json i YourLibrary.json. Rade i playliste izvezene iz aplikacije Glazba."
          }
        }
      }
    },
