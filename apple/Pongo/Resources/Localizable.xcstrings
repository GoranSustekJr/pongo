    "listentogetherbody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play your queue on your friends' phones at the same time, each on their own account and headphones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel deine Warteschlange gleichzeitig auf den Handys deiner Freunde ab, jeder mit seinem eigenen Konto und Kopfhörern."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducirajte svoj red na mobitelima prijatelja u isto vrijeme, svatko na svom računu i slušalicama."
          }
        }
      }
    },
    "listentogetherdescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or join a session to hear the same songs as your friends, at the same time"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte oder tritt einer Session bei und höre dieselben Lieder wie deine Freunde, gleichzeitig"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreni ili se pridruži sesiji i slušaj iste pjesme kao prijatelji, u isto vrijeme"
          }
        }
      }
    },
