      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A song can have several recordings with the same name, such as a re-recording years later. The one you pick plays for everyone on this server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lied kann mehrere Aufnahmen mit demselben Namen haben, etwa eine Neuaufnahme Jahre später. Die gewählte spielt für alle auf diesem Server."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesma može imati više snimki istog imena, npr. novu snimku godinama kasnije. Odabrana se pušta svima na ovom poslužitelju."
          }
        }
